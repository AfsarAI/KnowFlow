# KnowFlow Environment Configuration Template

# Application Configuration
ENVIRONMENT=development
PROJECT_NAME=KnowFlow
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-at-least-32-chars

# Supabase Authentication & PostgreSQL Configuration
# Found in Supabase Dashboard -> Project Settings -> API & JWT
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1

# PostgreSQL & pgvector Configuration (Local Docker or Supabase Database)
# Local development default:
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_DB=knowflow
POSTGRES_USER=knowflow
POSTGRES_PASSWORD=knowflow_dev_password
DATABASE_URL=postgresql+psycopg://knowflow:knowflow_dev_password@127.0.0.1:5434/knowflow

# AI & RAG Vector Search Configuration
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional Google Gemini Configuration (if using AI_PROVIDER=gemini)
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_EMBEDDING_MODEL=text-embedding-004
# GEMINI_CHAT_MODEL=gemini-1.5-flash

# Vector Dimensions & Retrieval Tuning
EMBEDDING_DIMENSION=1536
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.30
