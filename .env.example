# KnowFlow Environment Configuration Template

# Application Configuration
ENVIRONMENT=development
PROJECT_NAME=KnowFlow
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-at-least-32-chars

# PostgreSQL & pgvector Configuration
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_DB=knowflow
POSTGRES_USER=knowflow
POSTGRES_PASSWORD=knowflow_dev_password
DATABASE_URL=postgresql+psycopg://knowflow:knowflow_dev_password@127.0.0.1:5434/knowflow

